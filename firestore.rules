rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true && request.auth.token.email == 'aidenwerth27@gmail.com')
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidPaletteMap(m) {
      return m is map &&
             m.keys().hasAll(['bodyColor', 'billColor', 'hat', 'eyewear', 'accessory', 'pondBg']) &&
             m.keys().hasOnly(['bodyColor', 'billColor', 'hat', 'eyewear', 'accessory', 'pondBg', 'billStyle', 'wingStyle', 'eyeStyle']) &&
             m.bodyColor is string && m.bodyColor.size() >= 1 && m.bodyColor.size() <= 40 &&
             m.billColor is string && m.billColor.size() >= 1 && m.billColor.size() <= 40 &&
             m.hat is string && m.hat.size() >= 1 && m.hat.size() <= 40 &&
             m.eyewear is string && m.eyewear.size() >= 1 && m.eyewear.size() <= 40 &&
             m.accessory is string && m.accessory.size() >= 1 && m.accessory.size() <= 40 &&
             m.pondBg is string && m.pondBg.size() >= 1 && m.pondBg.size() <= 40 &&
             (!('billStyle' in m) || (m.billStyle is string && m.billStyle.size() >= 1 && m.billStyle.size() <= 40)) &&
             (!('wingStyle' in m) || (m.wingStyle is string && m.wingStyle.size() >= 1 && m.wingStyle.size() <= 40)) &&
             (!('eyeStyle' in m) || (m.eyeStyle is string && m.eyeStyle.size() >= 1 && m.eyeStyle.size() <= 40));
    }

    function isValidRarity(r) {
      return r is string && r in ['common', 'rare', 'epic', 'legendary'];
    }

    // --- ENTITY VALIDATION HELPERS ---
    function isValidCollectorProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 160)) &&
             isValidPaletteMap(data.avatarConfig) &&
             data.duckCount is int && data.duckCount >= 0 && data.duckCount <= 10000 &&
             data.tradesCompleted is int && data.tradesCompleted >= 0 && data.tradesCompleted <= 1000000 &&
             (!('banned' in data) || data.banned is bool) &&
             (!('banReason' in data) || (data.banReason is string && data.banReason.size() <= 200)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRedeemedCode(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
             data.rewardSummary is string && data.rewardSummary.size() >= 1 && data.rewardSummary.size() <= 120 &&
             isValidTimestamp(data.redeemedAt);
    }

    function isValidWallet(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.coins is int && data.coins >= 0 && data.coins <= 100000000 &&
             data.lastClaimId is string && data.lastClaimId.size() <= 128 &&
             data.lastClaimType is string && data.lastClaimType in ['none', 'daily', 'sale', 'trade_accept', 'trade_refund', 'promo', 'mission', 'showcase_vote', 'admin_grant'] &&
             (!('lastDailyClaimAt' in data) || isValidTimestamp(data.lastDailyClaimAt)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRubberDuck(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.speciesId is string && data.speciesId.size() >= 1 && data.speciesId.size() <= 40 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             isValidRarity(data.rarity) &&
             data.serialNumber is int && data.serialNumber >= 1 && data.serialNumber <= 1000000000 &&
             isValidPaletteMap(data.palette) &&
             data.listed is bool &&
             data.listingId is string && data.listingId.size() <= 128 &&
             data.lastTradeId is string && data.lastTradeId.size() <= 128 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidListing(data) {
      return data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128 &&
             data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 40 &&
             isValidPaletteMap(data.sellerAvatar) &&
             data.buyerId is string && data.buyerId.size() <= 128 &&
             data.duckId is string && isValidId(data.duckId) &&
             data.duckName is string && data.duckName.size() >= 1 && data.duckName.size() <= 40 &&
             data.duckSpeciesId is string && data.duckSpeciesId.size() >= 1 && data.duckSpeciesId.size() <= 40 &&
             isValidRarity(data.duckRarity) &&
             data.duckSerialNumber is int && data.duckSerialNumber >= 1 && data.duckSerialNumber <= 1000000000 &&
             isValidPaletteMap(data.duckPalette) &&
             data.askingCoins is int && data.askingCoins >= 1 && data.askingCoins <= 1000000 &&
             data.wantsTrade is bool &&
             data.desiredRarity is string && data.desiredRarity in ['any', 'common', 'rare', 'epic', 'legendary'] &&
             data.status is string && data.status in ['active', 'sold', 'cancelled'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTradeOffer(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 40 &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             data.participantIds[0] is string && data.participantIds[1] is string &&
             data.listingId is string && data.listingId.size() <= 128 &&
             data.offeredDuckId is string && isValidId(data.offeredDuckId) &&
             data.offeredDuckName is string && data.offeredDuckName.size() >= 1 && data.offeredDuckName.size() <= 40 &&
             isValidRarity(data.offeredDuckRarity) &&
             isValidPaletteMap(data.offeredDuckPalette) &&
             data.requestedDuckId is string && isValidId(data.requestedDuckId) &&
             data.requestedDuckName is string && data.requestedDuckName.size() >= 1 && data.requestedDuckName.size() <= 40 &&
             isValidRarity(data.requestedDuckRarity) &&
             isValidPaletteMap(data.requestedDuckPalette) &&
             data.offeredCoins is int && data.offeredCoins >= 0 && data.offeredCoins <= 100000 &&
             data.note is string && data.note.size() <= 140 &&
             data.status is string && data.status in ['pending', 'accepted', 'declined', 'cancelled'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCoinClaim(data) {
      return data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.sourceId is string && isValidId(data.sourceId) &&
             data.sourceType is string && data.sourceType in ['listing_sale', 'trade_refund', 'showcase_vote_reward'] &&
             (!('eventId' in data) || isValidId(data.eventId)) &&
             data.amount is int && data.amount >= 1 && data.amount <= 1000000 &&
             data.claimed is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWeeklyEvent(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.themeTag is string && data.themeTag.size() >= 1 && data.themeTag.size() <= 30 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&
             data.bonusRarity is string && data.bonusRarity in ['any', 'common', 'rare', 'epic', 'legendary'] &&
             data.active is bool &&
             data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 10000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEventEntry(data) {
      return data.eventId is string && isValidId(data.eventId) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.ownerDisplayName is string && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 40 &&
             isValidPaletteMap(data.ownerAvatar) &&
             data.duckId is string && isValidId(data.duckId) &&
             data.duckName is string && data.duckName.size() >= 1 && data.duckName.size() <= 40 &&
             data.duckSpeciesId is string && data.duckSpeciesId.size() >= 1 && data.duckSpeciesId.size() <= 40 &&
             isValidRarity(data.duckRarity) &&
             isValidPaletteMap(data.duckPalette) &&
             data.caption is string && data.caption.size() >= 1 && data.caption.size() <= 120 &&
             data.voteCount is int && data.voteCount >= 0 && data.voteCount <= 10000000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.type is string && data.type in ['trade_received', 'trade_accepted', 'trade_declined', 'listing_sold', 'event_started', 'showcase_vote', 'admin_announcement'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 200 &&
             data.referenceId is string && data.referenceId.size() <= 128 &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidDailyMission(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.missionId is string && data.missionId in ['visit_pond', 'hatch_egg', 'trade_duck', 'cheer_event'] &&
             data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 140 &&
             data.progress is int && data.progress >= 0 &&
             data.target is int && data.target >= 1 && data.progress <= data.target &&
             data.rewardCoins is int && data.rewardCoins >= 1 && data.rewardCoins <= 1000 &&
             data.claimed is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt) &&
             ((data.missionId == 'visit_pond' && data.target == 1 && data.rewardCoins == 40) ||
              (data.missionId == 'hatch_egg' && data.target == 1 && data.rewardCoins == 60) ||
              (data.missionId == 'trade_duck' && data.target == 1 && data.rewardCoins == 100) ||
              (data.missionId == 'cheer_event' && data.target == 1 && data.rewardCoins == 50));
    }

    // --- COLLECTION RULES ---

    // Owner/Admin registry: unlocked strictly with the secret owner code *OWNERDUCK#1*
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().ownerCode == '*OWNERDUCK#1*' &&
                       incoming().keys().hasAll(['userId', 'ownerCode', 'grantedAt']) &&
                       incoming().keys().hasOnly(['userId', 'ownerCode', 'grantedAt']) &&
                       isValidTimestamp(incoming().grantedAt);

      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().duckCount == 0 &&
                       incoming().tradesCompleted == 0 &&
                       incoming().banned == false &&
                       incoming().banReason == "" &&
                       incoming().keys().hasAll(['userId', 'displayName', 'avatarConfig', 'duckCount', 'tradesCompleted', 'banned', 'banReason', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'bio', 'avatarConfig', 'duckCount', 'tradesCompleted', 'banned', 'banReason', 'createdAt', 'updatedAt']) &&
                       isValidCollectorProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidCollectorProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isOwner(userId) &&
                          ((!('banned' in existing()) && !('banned' in incoming()) && !('banReason' in incoming())) ||
                           (!('banned' in existing()) && incoming().banned == false && incoming().banReason == "") ||
                           ('banned' in existing() && incoming().banned == existing().banned && incoming().banReason == existing().banReason)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'avatarConfig', 'duckCount', 'tradesCompleted', 'banned', 'banReason', 'updatedAt'])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['banned', 'banReason', 'duckCount', 'updatedAt']))
                       );

      allow delete: if false;

      match /redeemed_codes/{codeId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(codeId) &&
                         isValidRedeemedCode(incoming()) &&
                         incoming().userId == userId &&
                         incoming().code == codeId &&
                         incoming().keys().hasAll(['userId', 'code', 'rewardSummary', 'redeemedAt']) &&
                         incoming().keys().hasOnly(['userId', 'code', 'rewardSummary', 'redeemedAt']);

        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId);

        allow create: if isSignedIn() &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         incoming().userId == userId &&
                         incoming().read == false &&
                         incoming().keys().hasAll(['userId', 'type', 'title', 'body', 'referenceId', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'type', 'title', 'body', 'referenceId', 'read', 'createdAt']) &&
                         (isAdmin() || request.auth.uid == userId || incoming().type in ['trade_received', 'trade_accepted', 'trade_declined', 'listing_sold', 'showcase_vote']);

        allow update: if isOwner(userId) &&
                         isValidId(notificationId) &&
                         isValidNotification(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().type == existing().type &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if isOwner(userId) && isValidId(notificationId);
      }

      match /daily_missions/{missionDocId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(missionDocId) &&
                         isValidDailyMission(incoming()) &&
                         missionDocId == (incoming().dateKey + '_' + incoming().missionId) &&
                         incoming().userId == userId &&
                         incoming().claimed == false &&
                         incoming().keys().hasAll(['userId', 'missionId', 'dateKey', 'title', 'description', 'progress', 'target', 'rewardCoins', 'claimed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'missionId', 'dateKey', 'title', 'description', 'progress', 'target', 'rewardCoins', 'claimed', 'createdAt', 'updatedAt']);

        allow update: if isOwner(userId) &&
                         isValidId(missionDocId) &&
                         isValidDailyMission(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().missionId == existing().missionId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().target == existing().target &&
                         incoming().rewardCoins == existing().rewardCoins &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (existing().claimed == false &&
                            incoming().claimed == false &&
                            incoming().progress >= existing().progress &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'updatedAt'])) ||
                           (existing().claimed == false &&
                            incoming().claimed == true &&
                            existing().progress >= existing().target &&
                            incoming().progress == existing().progress &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['claimed', 'updatedAt']))
                         );

        allow delete: if false;
      }
    }

    match /wallets/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      function isValidShowcaseVoteReward(uid, eventId, entryId) {
        return !exists(/databases/$(database)/documents/weekly_events/$(eventId)/entries/$(entryId)/votes/$(uid)) &&
               existsAfter(/databases/$(database)/documents/weekly_events/$(eventId)/entries/$(entryId)/votes/$(uid)) &&
               get(/databases/$(database)/documents/weekly_events/$(eventId)/entries/$(entryId)).data.userId != uid;
      }

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().coins == 250 &&
                       incoming().lastClaimId == "" &&
                       incoming().lastClaimType == "none" &&
                       incoming().keys().hasAll(['userId', 'coins', 'lastClaimId', 'lastClaimType', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'coins', 'lastClaimId', 'lastClaimType', 'lastDailyClaimAt', 'createdAt', 'updatedAt']) &&
                       isValidWallet(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidWallet(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (incoming().lastClaimType == 'daily' &&
                          isOwner(userId) &&
                          incoming().coins - existing().coins == 75 &&
                          'lastDailyClaimAt' in incoming() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'lastClaimId', 'lastClaimType', 'lastDailyClaimAt', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['coins', 'lastClaimId', 'lastClaimType', 'updatedAt']) &&
                          (
                            // Admin grant / adjust Grapes
                            (incoming().lastClaimType == 'admin_grant' && isAdmin()) ||
                            (isOwner(userId) && (
                              // Action 1: Spend Grapes
                              (incoming().lastClaimType == 'none' &&
                               incoming().coins < existing().coins) ||
                              // Action 3: Claim escrowed sale payout, trade refund, or showcase vote owner bonus
                              (incoming().lastClaimType == 'sale' &&
                               incoming().lastClaimId != "" &&
                               get(/databases/$(database)/documents/coin_claims/$(incoming().lastClaimId)).data.claimed == false &&
                               get(/databases/$(database)/documents/coin_claims/$(incoming().lastClaimId)).data.recipientId == request.auth.uid &&
                               getAfter(/databases/$(database)/documents/coin_claims/$(incoming().lastClaimId)).data.claimed == true &&
                               incoming().coins - existing().coins == get(/databases/$(database)/documents/coin_claims/$(incoming().lastClaimId)).data.amount) ||
                              // Action 4: Accept trade with bonus Grapes
                              (incoming().lastClaimType == 'trade_accept' &&
                               incoming().lastClaimId != "" &&
                               get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.status == 'pending' &&
                               get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.recipientId == request.auth.uid &&
                               getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.status == 'accepted' &&
                               incoming().coins - existing().coins == get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.offeredCoins) ||
                              // Action 5: Refund escrowed trade bonus Grapes on cancel
                              (incoming().lastClaimType == 'trade_refund' &&
                               incoming().lastClaimId != "" &&
                               get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.status == 'pending' &&
                               get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.senderId == request.auth.uid &&
                               getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.status in ['cancelled', 'declined'] &&
                               incoming().coins - existing().coins == get(/databases/$(database)/documents/trade_offers/$(incoming().lastClaimId)).data.offeredCoins) ||
                              // Action 6: Promo code Grape grant (QUACK100, SPLASH250, POND500)
                              (incoming().lastClaimType == 'promo' &&
                               incoming().lastClaimId in ['QUACK100', 'SPLASH250', 'POND500'] &&
                               !exists(/databases/$(database)/documents/users/$(userId)/redeemed_codes/$(incoming().lastClaimId)) &&
                               existsAfter(/databases/$(database)/documents/users/$(userId)/redeemed_codes/$(incoming().lastClaimId)) &&
                               ((incoming().lastClaimId == 'QUACK100' && incoming().coins - existing().coins == 100) ||
                                (incoming().lastClaimId == 'SPLASH250' && incoming().coins - existing().coins == 250) ||
                                (incoming().lastClaimId == 'POND500' && incoming().coins - existing().coins == 500))) ||
                              // Action 7: Claim completed daily mission Grape reward
                              (incoming().lastClaimType == 'mission' &&
                               incoming().lastClaimId != "" &&
                               get(/databases/$(database)/documents/users/$(userId)/daily_missions/$(incoming().lastClaimId)).data.claimed == false &&
                               get(/databases/$(database)/documents/users/$(userId)/daily_missions/$(incoming().lastClaimId)).data.progress >= get(/databases/$(database)/documents/users/$(userId)/daily_missions/$(incoming().lastClaimId)).data.target &&
                               getAfter(/databases/$(database)/documents/users/$(userId)/daily_missions/$(incoming().lastClaimId)).data.claimed == true &&
                               incoming().coins - existing().coins == get(/databases/$(database)/documents/users/$(userId)/daily_missions/$(incoming().lastClaimId)).data.rewardCoins) ||
                              // Action 8: Earn +15 Bonus Grapes when voting on another collector's showcase duck
                              (incoming().lastClaimType == 'showcase_vote' &&
                               incoming().coins - existing().coins == 15 &&
                               incoming().lastClaimId.split('__').size() == 2 &&
                               isValidShowcaseVoteReward(userId, incoming().lastClaimId.split('__')[0], incoming().lastClaimId.split('__')[1]))
                            ))
                          ))
                       );

      allow delete: if false;
    }

    match /ducks/{duckId} {
      allow get: if isSignedIn() && isValidId(duckId);
      allow list: if isSignedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid || resource.data.listed == true);

      allow create: if isSignedIn() &&
                       isValidId(duckId) &&
                       isValidRubberDuck(incoming()) &&
                       (isAdmin() || incoming().ownerId == request.auth.uid) &&
                       incoming().listed == false &&
                       incoming().listingId == "" &&
                       incoming().lastTradeId == "" &&
                       incoming().keys().hasAll(['ownerId', 'speciesId', 'name', 'rarity', 'serialNumber', 'palette', 'listed', 'listingId', 'lastTradeId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerId', 'speciesId', 'name', 'rarity', 'serialNumber', 'palette', 'listed', 'listingId', 'lastTradeId', 'createdAt', 'updatedAt']);

      allow update: if isSignedIn() &&
                       isValidId(duckId) &&
                       isValidRubberDuck(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().speciesId == existing().speciesId &&
                       incoming().serialNumber == existing().serialNumber &&
                       (
                         (existing().ownerId == request.auth.uid &&
                          incoming().ownerId == existing().ownerId &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'listed', 'listingId', 'updatedAt'])) ||
                         (existing().listed == true &&
                          existing().listingId != "" &&
                          incoming().ownerId == request.auth.uid &&
                          incoming().listed == false &&
                          incoming().listingId == "" &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'listed', 'listingId', 'updatedAt']) &&
                          get(/databases/$(database)/documents/marketplace_listings/$(existing().listingId)).data.status == 'active' &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(existing().listingId)).data.status == 'sold' &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(existing().listingId)).data.buyerId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(existing().listingId)).data.duckId == duckId) ||
                         (incoming().lastTradeId != "" &&
                          incoming().listed == false &&
                          incoming().listingId == "" &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ownerId', 'listed', 'listingId', 'lastTradeId', 'updatedAt']) &&
                          get(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.status == 'pending' &&
                          get(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.recipientId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.status == 'accepted' &&
                          ((duckId == getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.offeredDuckId &&
                            existing().ownerId == getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.senderId &&
                            incoming().ownerId == request.auth.uid) ||
                           (duckId == getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.requestedDuckId &&
                            existing().ownerId == request.auth.uid &&
                            incoming().ownerId == getAfter(/databases/$(database)/documents/trade_offers/$(incoming().lastTradeId)).data.senderId)))
                       );

      allow delete: if isSignedIn() && isValidId(duckId) && (isAdmin() || (existing().ownerId == request.auth.uid && existing().listed == false));
    }

    match /marketplace_listings/{listingId} {
      allow get: if isSignedIn() && isValidId(listingId);
      allow list: if isSignedIn() && (isAdmin() || resource.data.status == 'active' || resource.data.sellerId == request.auth.uid || resource.data.buyerId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(listingId) &&
                       isValidListing(incoming()) &&
                       incoming().sellerId == request.auth.uid &&
                       incoming().buyerId == "" &&
                       incoming().status == 'active' &&
                       incoming().keys().hasAll(['sellerId', 'sellerName', 'sellerAvatar', 'buyerId', 'duckId', 'duckName', 'duckSpeciesId', 'duckRarity', 'duckSerialNumber', 'duckPalette', 'askingCoins', 'wantsTrade', 'desiredRarity', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['sellerId', 'sellerName', 'sellerAvatar', 'buyerId', 'duckId', 'duckName', 'duckSpeciesId', 'duckRarity', 'duckSerialNumber', 'duckPalette', 'askingCoins', 'wantsTrade', 'desiredRarity', 'status', 'createdAt', 'updatedAt']) &&
                       exists(/databases/$(database)/documents/ducks/$(incoming().duckId)) &&
                       get(/databases/$(database)/documents/ducks/$(incoming().duckId)).data.ownerId == request.auth.uid;

      allow update: if isSignedIn() &&
                       isValidId(listingId) &&
                       isValidListing(incoming()) &&
                       existing().status == 'active' &&
                       incoming().sellerId == existing().sellerId &&
                       incoming().duckId == existing().duckId &&
                       incoming().askingCoins == existing().askingCoins &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         ((existing().sellerId == request.auth.uid || isAdmin()) &&
                          incoming().status == 'cancelled' &&
                          incoming().buyerId == "" &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (existing().sellerId != request.auth.uid &&
                          incoming().status == 'sold' &&
                          incoming().buyerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'buyerId', 'updatedAt']) &&
                          getAfter(/databases/$(database)/documents/ducks/$(existing().duckId)).data.ownerId == request.auth.uid)
                       );

      allow delete: if false;
    }

    match /trade_offers/{tradeId} {
      allow get, list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.participantIds);

      allow create: if isSignedIn() &&
                       isValidId(tradeId) &&
                       isValidTradeOffer(incoming()) &&
                       incoming().senderId == request.auth.uid &&
                       incoming().recipientId != request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().senderId in incoming().participantIds &&
                       incoming().recipientId in incoming().participantIds &&
                       incoming().keys().hasAll(['senderId', 'senderName', 'recipientId', 'recipientName', 'participantIds', 'listingId', 'offeredDuckId', 'offeredDuckName', 'offeredDuckRarity', 'offeredDuckPalette', 'requestedDuckId', 'requestedDuckName', 'requestedDuckRarity', 'requestedDuckPalette', 'offeredCoins', 'note', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['senderId', 'senderName', 'recipientId', 'recipientName', 'participantIds', 'listingId', 'offeredDuckId', 'offeredDuckName', 'offeredDuckRarity', 'offeredDuckPalette', 'requestedDuckId', 'requestedDuckName', 'requestedDuckRarity', 'requestedDuckPalette', 'offeredCoins', 'note', 'status', 'createdAt', 'updatedAt']) &&
                       exists(/databases/$(database)/documents/ducks/$(incoming().offeredDuckId)) &&
                       get(/databases/$(database)/documents/ducks/$(incoming().offeredDuckId)).data.ownerId == request.auth.uid &&
                       exists(/databases/$(database)/documents/ducks/$(incoming().requestedDuckId)) &&
                       get(/databases/$(database)/documents/ducks/$(incoming().requestedDuckId)).data.ownerId == incoming().recipientId;

      allow update: if isSignedIn() &&
                       isValidId(tradeId) &&
                       isValidTradeOffer(incoming()) &&
                       existing().status == 'pending' &&
                       incoming().senderId == existing().senderId &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().offeredDuckId == existing().offeredDuckId &&
                       incoming().requestedDuckId == existing().requestedDuckId &&
                       incoming().offeredCoins == existing().offeredCoins &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       (
                         (request.auth.uid == existing().senderId && incoming().status == 'cancelled') ||
                         (request.auth.uid == existing().recipientId && incoming().status == 'declined') ||
                         (request.auth.uid == existing().recipientId &&
                          incoming().status == 'accepted' &&
                          getAfter(/databases/$(database)/documents/ducks/$(existing().offeredDuckId)).data.ownerId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/ducks/$(existing().requestedDuckId)).data.ownerId == existing().senderId)
                       );

      allow delete: if false;
    }

    match /coin_claims/{claimId} {
      allow get, list: if isSignedIn() && resource.data.recipientId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(claimId) &&
                       isValidCoinClaim(incoming()) &&
                       incoming().claimed == false &&
                       incoming().keys().hasAll(['recipientId', 'sourceId', 'sourceType', 'amount', 'claimed', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['recipientId', 'sourceId', 'sourceType', 'eventId', 'amount', 'claimed', 'createdAt', 'updatedAt']) &&
                       (
                         (incoming().sourceType == 'listing_sale' &&
                          claimId == ('sale_' + incoming().sourceId) &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(incoming().sourceId)).data.status == 'sold' &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(incoming().sourceId)).data.buyerId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(incoming().sourceId)).data.sellerId == incoming().recipientId &&
                          getAfter(/databases/$(database)/documents/marketplace_listings/$(incoming().sourceId)).data.askingCoins == incoming().amount) ||
                         (incoming().sourceType == 'trade_refund' &&
                          claimId == ('refund_' + incoming().sourceId) &&
                          get(/databases/$(database)/documents/trade_offers/$(incoming().sourceId)).data.status == 'pending' &&
                          get(/databases/$(database)/documents/trade_offers/$(incoming().sourceId)).data.recipientId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/trade_offers/$(incoming().sourceId)).data.status == 'declined' &&
                          getAfter(/databases/$(database)/documents/trade_offers/$(incoming().sourceId)).data.senderId == incoming().recipientId &&
                          getAfter(/databases/$(database)/documents/trade_offers/$(incoming().sourceId)).data.offeredCoins == incoming().amount) ||
                         (incoming().sourceType == 'showcase_vote_reward' &&
                          'eventId' in incoming() &&
                          isValidId(incoming().eventId) &&
                          claimId == ('vote_' + incoming().sourceId + '_' + request.auth.uid) &&
                          incoming().amount == 25 &&
                          incoming().recipientId != request.auth.uid &&
                          !exists(/databases/$(database)/documents/weekly_events/$(incoming().eventId)/entries/$(incoming().sourceId)/votes/$(request.auth.uid)) &&
                          existsAfter(/databases/$(database)/documents/weekly_events/$(incoming().eventId)/entries/$(incoming().sourceId)/votes/$(request.auth.uid)) &&
                          get(/databases/$(database)/documents/weekly_events/$(incoming().eventId)/entries/$(incoming().sourceId)).data.userId == incoming().recipientId)
                       );

      allow update: if isSignedIn() &&
                       isValidId(claimId) &&
                       isValidCoinClaim(incoming()) &&
                       existing().recipientId == request.auth.uid &&
                       existing().claimed == false &&
                       incoming().claimed == true &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().sourceId == existing().sourceId &&
                       incoming().sourceType == existing().sourceType &&
                       incoming().amount == existing().amount &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['claimed', 'updatedAt']);

      allow delete: if false;
    }

    match /weekly_events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId);
      allow list: if isSignedIn() && resource.data.weekNumber >= 1;

      allow create: if isSignedIn() &&
                       isValidId(eventId) &&
                       isValidWeeklyEvent(incoming()) &&
                       (isAdmin() || eventId in ['week_golden_splash', 'week_rainy_parade', 'week_neon_swim']) &&
                       incoming().keys().hasAll(['title', 'themeTag', 'description', 'bonusRarity', 'active', 'weekNumber', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'themeTag', 'description', 'bonusRarity', 'active', 'weekNumber', 'createdAt', 'updatedAt']);

      allow update: if isAdmin() &&
                       isValidId(eventId) &&
                       isValidWeeklyEvent(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'title', 'themeTag', 'description', 'bonusRarity', 'updatedAt']);

      allow delete: if false;

      match /entries/{entryId} {
        allow get, list: if isSignedIn() && resource.data.eventId == eventId;

        allow create: if isSignedIn() &&
                         isValidId(entryId) &&
                         isValidEventEntry(incoming()) &&
                         incoming().eventId == eventId &&
                         incoming().userId == request.auth.uid &&
                         incoming().voteCount == 0 &&
                         incoming().keys().hasAll(['eventId', 'userId', 'ownerDisplayName', 'ownerAvatar', 'duckId', 'duckName', 'duckSpeciesId', 'duckRarity', 'duckPalette', 'caption', 'voteCount', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['eventId', 'userId', 'ownerDisplayName', 'ownerAvatar', 'duckId', 'duckName', 'duckSpeciesId', 'duckRarity', 'duckPalette', 'caption', 'voteCount', 'createdAt', 'updatedAt']) &&
                         exists(/databases/$(database)/documents/ducks/$(incoming().duckId)) &&
                         get(/databases/$(database)/documents/ducks/$(incoming().duckId)).data.ownerId == request.auth.uid;

        allow update: if isSignedIn() &&
                         isValidId(entryId) &&
                         isValidEventEntry(incoming()) &&
                         incoming().eventId == existing().eventId &&
                         incoming().userId == existing().userId &&
                         incoming().duckId == existing().duckId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (existing().userId == request.auth.uid &&
                            incoming().voteCount == existing().voteCount &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['caption', 'updatedAt'])) ||
                           (existing().userId != request.auth.uid &&
                            incoming().voteCount == existing().voteCount + 1 &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['voteCount', 'updatedAt']) &&
                            !exists(/databases/$(database)/documents/weekly_events/$(eventId)/entries/$(entryId)/votes/$(request.auth.uid)) &&
                            existsAfter(/databases/$(database)/documents/weekly_events/$(eventId)/entries/$(entryId)/votes/$(request.auth.uid)))
                         );

        allow delete: if isSignedIn() && isValidId(entryId) && (isAdmin() || existing().userId == request.auth.uid);

        match /votes/{voterId} {
          allow get, list: if isOwner(voterId);

          allow create: if isOwner(voterId) &&
                           isValidId(voterId) &&
                           incoming().voterId == request.auth.uid &&
                           incoming().entryId == entryId &&
                           incoming().keys().hasAll(['voterId', 'entryId', 'createdAt']) &&
                           incoming().keys().hasOnly(['voterId', 'entryId', 'createdAt']) &&
                           isValidTimestamp(incoming().createdAt);

          allow update, delete: if false;
        }
      }
    }
  }
}
